# Application
NODE_ENV=development
APP_NAME=NsProject
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# Database
DATABASE_URL=postgresql://nsproject:nsproject_password@localhost:5432/nsproject_db
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=nsproject_db
DATABASE_USER=nsproject
DATABASE_PASSWORD=nsproject_password

# Redis
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# NextAuth
NEXTAUTH_SECRET=your-nextauth-secret-key-change-in-production
NEXTAUTH_URL=http://localhost:3000

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Microsoft OAuth
MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret

# WhatsApp / Evolution API
WHATSAPP_API_URL=http://localhost:8080
WHATSAPP_API_KEY=your-evolution-api-key
WHATSAPP_INSTANCE=nsproject

# n8n
N8N_URL=http://localhost:5678
N8N_API_KEY=your-n8n-api-key

# S3 Storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=nsproject-storage
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=no-reply@nsproject.com

# Socket.IO
SOCKET_PORT=4001

# API
API_PORT=4000
API_PREFIX=api
SWAGGER_ENABLED=true

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_SOCKET_URL=http://localhost:4001
NEXT_PUBLIC_APP_NAME=NsProject
